# West workspace, fetched via `make setup` (several GB) — never commit.
# These are siblings of app/ once `west update` has run.
/.west/
/zephyr/
/nrf/
/modules/
/bootloader/
/nrfxlib/
/test/
/tools/
/mbedtls/
/bsim/

# Build output
/build/
/build_appcore/

# DFU image-signing key (generated by `make dfu-keygen`) — private key
# material, never commit. Back it up outside of git instead.
/app/dfu_signing_key.pem

# Optional local Python venv for the west/toolchain requirements
/.venv/

# Machine-local toolchain environment (see toolchain.mk.example) — paths
# are specific to one machine's NCS Toolchain Manager install, never commit.
/toolchain.mk
