Do not hardcode C std to C99 or C++ std to C++11 if not set

OE compilers default to newer standards and abseil (via protobuf) needs
C++14 or newer. Rebased version of meta-oe default-cxx-std.patch for
thread-reference-20250612.

Upstream-Status: Inappropriate [OE specific]

diff --git CMakeLists.txt CMakeLists.txt
index 26cccb4..fa071fc 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -46,16 +46,6 @@ set_property(CACHE OTBR_MDNS PROPERTY STRINGS "avahi" "mDNSResponder")
 
 include("${PROJECT_SOURCE_DIR}/etc/cmake/options.cmake")
 
-if(NOT CMAKE_C_STANDARD)
-    set(CMAKE_C_STANDARD 99)
-    set(CMAKE_C_STANDARD_REQUIRED ON)
-endif()
-
-if(NOT CMAKE_CXX_STANDARD)
-    set(CMAKE_CXX_STANDARD 11)
-    set(CMAKE_CXX_STANDARD_REQUIRED ON)
-endif()
-
 set(CMAKE_CXX_EXTENSIONS OFF)
 set(CMAKE_EXE_LINKER_FLAGS "-rdynamic ${CMAKE_EXE_LINKER_FLAGS}")
 
