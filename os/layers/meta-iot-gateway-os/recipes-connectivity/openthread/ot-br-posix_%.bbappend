FILESEXTRAPATHS:prepend := "${THISDIR}/ot-br-posix:"

# Newer ot-br-posix than meta-oe scarthgap (a35cc682, 2024-03).
# Why: from this version on the MeshCoP mDNS TXT data is generated by the
# OpenThread core and includes the Thread role in the "sb" state bitmap
# (bits 9-10). The old version always announced role 0 (disabled/detached),
# so Android / Google Play Services listed the network as "not available"
# and refused Matter-over-Thread commissioning.
# thread-reference-20250612 is the last release with OTBR_MDNS=avahi; from
# v2026.x on only the OpenThread-native mDNS or mDNSResponder are supported.
#
# Upgrading an existing gateway: the new version does not pick up the Thread
# network stored by the old one, and thread-network-init.sh then forms a NEW
# network (all devices drop off). Back up the dataset first and restore it:
#   ot-ctl dataset active -x | head -n1 > /root/dataset.hex      (before)
#   ot-ctl thread stop; ot-ctl ifconfig down
#   ot-ctl dataset set active $(tr -cd 0-9a-fA-F < /root/dataset.hex)
#   ot-ctl ifconfig up; ot-ctl thread start                      (after)
SRCREV = "2f3c799c7463c8f674754e65c53f78bc0bbcbd58"
PV = "0.3.0+thread-reference-20250612+git"

# Simple-web-server was replaced by cpp-httplib (MIT) for the REST server.
LIC_FILES_CHKSUM = "file://LICENSE;md5=87109e44b2fda96a8991f27684a7349c \
                    file://third_party/cJSON/repo/LICENSE;md5=218947f77e8cb8e2fa02918dc41c50d0 \
                    file://third_party/cpp-httplib/repo/LICENSE;md5=1321bdf796c67e3a8ab8e352dd81474b \
                    file://third_party/http-parser/repo/LICENSE-MIT;md5=9bfa835d048c194ab30487af8d7b3778 \
                    file://third_party/openthread/repo/LICENSE;md5=543b6fe90ec5901a683320a36390c65f \
                    "

# meta-oe's default-cxx-std.patch no longer applies (rebased copy below);
# musl-fixes.patch is only relevant for musl (we use glibc) and no longer applies.
SRC_URI:remove = "file://default-cxx-std.patch file://musl-fixes.patch"
SRC_URI:append = " file://0001-cmake-do-not-hardcode-c-cxx-standard.patch"

# Wi-Fi LAN on both boards: the LAN with Home Assistant (Matter server) is
# reached via Wi-Fi. Border routing (OMR prefix) and the SRP server stay
# stopped without IPv6 on the infra interface, so Matter controllers could
# not reach Thread devices (on Dahlia end0 is only a point-to-point link to
# the build host).
# @USER_CONFIG: Network interface connected to the backbone (IP) network with IPv6
OTBR_INFRA_IFACE ?= "mlan0"

# Next hop of the LAN router's static IPv6 route to the Thread network:
#   route OTBR_OMR_PREFIX (thread-network-init) via OTBR_INFRA_IPV6_ADDRESS
# Set as fixed address on OTBR_INFRA_IFACE by a NetworkManager dispatcher
# script, so the route survives a re-flash. Must be inside the LAN's IPv6
# prefix (FritzBox ULA). Default: the Dahlia dev setup's current address.
# @USER_CONFIG: Fixed IPv6 address/prefix length of the gateway on OTBR_INFRA_IFACE, next hop of the LAN router's route to OTBR_OMR_PREFIX (empty = none)
OTBR_INFRA_IPV6_ADDRESS ?= "fd8f:e72d:8065:0:3f1e:f55:3464:19db/64"

# @USER_CONFIG: Thread RCP device path (nRF5340 flashed with OpenThread RCP firmware, connected via UART_4)
OTBR_RCP_DEVICE ?= "/dev/thread"

# Override infra interface (upstream defaults to eth0)
EXTRA_OECMAKE:remove = "-DOTBR_INFRA_IF_NAME=eth0"
EXTRA_OECMAKE:append = " -DOTBR_INFRA_IF_NAME=${OTBR_INFRA_IFACE}"

SRC_URI:append = " \
    file://otbr-agent-gateway.conf \
    file://99-thread.rules \
    file://10-module-power.conf \
    file://60-otbr-ipv6-forwarding.conf \
    file://50-otbr-infra-ipv6 \
"

# Powers the nRF5340 before otbr-agent starts (see 10-module-power.conf)
RDEPENDS:${PN} += "gateway-module-power"

do_install:append() {
    install -d ${D}${sysconfdir}/default
    sed -e 's|@OTBR_INFRA_IFACE@|${OTBR_INFRA_IFACE}|g' \
        -e 's|@OTBR_RCP_DEVICE@|${OTBR_RCP_DEVICE}|g' \
        ${WORKDIR}/otbr-agent-gateway.conf > ${D}${sysconfdir}/default/otbr-agent

    install -d ${D}${nonarch_base_libdir}/udev/rules.d
    install -m 0644 ${WORKDIR}/99-thread.rules ${D}${nonarch_base_libdir}/udev/rules.d/99-thread.rules

    install -d ${D}${systemd_system_unitdir}/otbr-agent.service.d
    install -m 0644 ${WORKDIR}/10-module-power.conf ${D}${systemd_system_unitdir}/otbr-agent.service.d/

    install -d ${D}${sysconfdir}/sysctl.d
    install -m 0644 ${WORKDIR}/60-otbr-ipv6-forwarding.conf ${D}${sysconfdir}/sysctl.d/

    install -d ${D}${sysconfdir}/NetworkManager/dispatcher.d
    sed -e 's|@OTBR_INFRA_IFACE@|${OTBR_INFRA_IFACE}|g' \
        -e 's|@OTBR_INFRA_IPV6_ADDRESS@|${OTBR_INFRA_IPV6_ADDRESS}|g' \
        ${WORKDIR}/50-otbr-infra-ipv6 > ${D}${sysconfdir}/NetworkManager/dispatcher.d/50-otbr-infra-ipv6
    chmod 0755 ${D}${sysconfdir}/NetworkManager/dispatcher.d/50-otbr-infra-ipv6
}

FILES:${PN} += " \
    ${sysconfdir}/default/otbr-agent \
    ${nonarch_base_libdir}/udev/rules.d/99-thread.rules \
    ${systemd_system_unitdir}/otbr-agent.service.d/10-module-power.conf \
    ${sysconfdir}/sysctl.d/60-otbr-ipv6-forwarding.conf \
    ${sysconfdir}/NetworkManager/dispatcher.d/50-otbr-infra-ipv6 \
"
