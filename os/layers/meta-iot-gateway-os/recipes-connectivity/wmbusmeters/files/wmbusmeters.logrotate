# wmbusmeters keeps its log file open and has no reopen signal, hence
# copytruncate. Without a receiver it logs a line every ~2 s.
/var/log/wmbusmeters/*.log {
    size 1M
    rotate 3
    compress
    missingok
    notifempty
    copytruncate
    # Numbered files instead of the global dateext: logrotate runs hourly,
    # a second size-triggered rotation on the same day would fail with
    # "destination ...-YYYYMMDD.gz already exists".
    nodateext
}
