[Unit]
Description=Bring up CAN interface %i (bitrate from /etc/default/gateway-can)
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/default/gateway-can
ExecStart=/usr/sbin/ip link set %i down
ExecStart=/usr/sbin/ip link set %i type can bitrate ${CAN_BITRATE} restart-ms ${CAN_RESTART_MS}
ExecStart=/usr/sbin/ip link set %i up
ExecStop=/usr/sbin/ip link set %i down

[Install]
WantedBy=multi-user.target
