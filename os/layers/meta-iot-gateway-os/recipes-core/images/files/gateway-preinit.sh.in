#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Daniel Kampert

# GatewayOS preinit (/sbin/preinit, kernel argument init=/sbin/preinit), based
# on OE-core's overlayfs-etc-preinit.sh.in. Generated by the overlayfs-etc
# image feature from this template (Python str.format placeholders).
#
# Mounts the DATA partition on {OVERLAYFS_ETC_MOUNT_POINT} and overlays /etc, /var/lib, /home
# and /root with it before systemd starts (the rootfs itself is read-only). Everything written there (network and WiFi
# settings, SSH host keys, machine-id, Zigbee/Thread networks, ...) lives on
# DATA and survives RAUC updates, which replace the whole rootfs slot. Files
# from the image stay visible below the overlay unless they were changed.

echo "PREINIT: Start"

PATH=/sbin:/bin:/usr/sbin:/usr/bin
if {CREATE_MOUNT_DIRS}; then
    mount -o remount,rw /

    mkdir -p /proc
    mkdir -p /sys
    mkdir -p /run
    mkdir -p /var/run
    mkdir -p {OVERLAYFS_ETC_MOUNT_POINT}
fi

mount -t proc proc /proc
mount -t sysfs sysfs /sys

if mount -n -t {OVERLAYFS_ETC_FSTYPE} \
    -o {OVERLAYFS_ETC_MOUNT_OPTIONS} \
    {OVERLAYFS_ETC_DEVICE} {OVERLAYFS_ETC_MOUNT_POINT}
then
    # Restore a gateway-backup archive (README "Backup"): replaces the overlay
    # contents before they are mounted. Unpacked next to them first, so a
    # broken archive leaves the current state untouched.
    restore={OVERLAYFS_ETC_MOUNT_POINT}/restore.tar.gz
    if [ -f "$restore" ]; then
        echo "PREINIT: Restoring $restore"
        tmp={OVERLAYFS_ETC_MOUNT_POINT}/restore.tmp
        rm -rf "$tmp" && mkdir -p "$tmp"
        if tar -C "$tmp" -xzf "$restore" --xattrs --xattrs-include='trusted.*' --numeric-owner; then
            for name in etc var-lib home root; do
                if [ -d "$tmp/overlay-$name/upper" ]; then
                    rm -rf {OVERLAYFS_ETC_MOUNT_POINT}/overlay-$name
                    mv "$tmp/overlay-$name" {OVERLAYFS_ETC_MOUNT_POINT}/overlay-$name
                fi
            done
            mv "$restore" "$restore.done"
            echo "PREINIT: Restore done"
        else
            mv "$restore" "$restore.failed"
            echo "PREINIT: Restore failed, keeping the current data!"
        fi
        rm -rf "$tmp"
    fi

    for dir in /etc /var/lib /home /root; do
        # /etc -> overlay-etc, /var/lib -> overlay-var-lib
        name=$(echo "$dir" | sed -e 's|^/||' -e 's|/|-|g')
        base={OVERLAYFS_ETC_MOUNT_POINT}/overlay-$name
        mkdir -p "$base/upper" "$base/work" "$dir"

        mount -n -t overlay \
            -o upperdir="$base/upper" \
            -o lowerdir="$dir" \
            -o workdir="$base/work" \
            -o index=off,xino=off,redirect_dir=off,metacopy=off \
            "overlay-$name" "$dir" || \
                echo "PREINIT: Mounting $dir overlay failed!"
    done
else
    echo "PREINIT: Mounting {OVERLAYFS_ETC_DEVICE} on {OVERLAYFS_ETC_MOUNT_POINT} failed, changes will not survive updates!"
fi

echo "PREINIT: done; starting {SBIN_INIT_NAME}"
exec {SBIN_INIT_NAME}
