# SPDX-License-Identifier: GPL-2.0+ OR MIT
#
# Copyright 2020 Toradex
#
# GatewayOS boot script with A/B slot selection for RAUC, based on the
# Toradex boot script (meta-toradex-bsp-common u-boot-distro-boot).
#
# eMMC layout (gateway-os-image.bb, gateway_tezi_ab_layout):
#   1 BOOT (FAT, this script), 2 rootfs slot A, 3 rootfs slot B, 4 DATA
# Each slot carries its own kernel and devicetree in /boot.
#
# Slot selection (RAUC U-Boot bootchooser convention):
#   BOOT_ORDER   slots in priority order, e.g. "A B"
#   BOOT_A_LEFT  remaining boot attempts of slot A (same for B)
# Each boot takes one attempt from the first slot that has attempts left.
# rauc-mark-good.service resets the counter once the system is up. A slot
# that fails 3 times in a row is skipped, so the gateway falls back to the
# other slot. "rauc install" writes the inactive slot and puts it first in
# BOOT_ORDER.
#
# Changes compared to the Toradex script: slot selection, kernel and
# devicetree are loaded from <slot>/boot, kernel arguments rauc.slot= and
# init=/sbin/preinit (mounts the DATA overlays before systemd starts),
# no fitImage / network boot.

if test "${devtype}" != "mmc"; then
    echo "GatewayOS: boot script only supports eMMC/SD (devtype ${devtype})"
    exit
fi

test -n "${BOOT_ORDER}" || env set BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || env set BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || env set BOOT_B_LEFT 3

env set rauc_part
env set rauc_slot
for BOOT_SLOT in "${BOOT_ORDER}"; do
    if test "x${rauc_part}" != "x"; then
        true
    elif test "x${BOOT_SLOT}" = "xA"; then
        if test ${BOOT_A_LEFT} -gt 0; then
            setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
            echo "GatewayOS: booting slot A, ${BOOT_A_LEFT} attempts left"
            env set rauc_part 2
            env set rauc_slot A
        fi
    elif test "x${BOOT_SLOT}" = "xB"; then
        if test ${BOOT_B_LEFT} -gt 0; then
            setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
            echo "GatewayOS: booting slot B, ${BOOT_B_LEFT} attempts left"
            env set rauc_part 3
            env set rauc_slot B
        fi
    fi
done

# No slot with attempts left: give both slots 3 new attempts and reset.
if test -n "${rauc_part}"; then
    saveenv
else
    echo "GatewayOS: no bootable slot left, resetting the attempt counters"
    env set BOOT_A_LEFT 3
    env set BOOT_B_LEFT 3
    saveenv
    reset
fi

test -n "${m4boot}" || env set m4boot ';'
test -n "${fdtfile}" || env set fdtfile ${fdt_file}
env set boot_part ${rauc_part}
env set root_part ${rauc_part}
test -n "${kernel_image}" || env set kernel_image @@KERNEL_IMAGETYPE@@
env set load_cmd "load ${devtype} ${devnum}:${boot_part}"

# Set console baudrate only when required
setexpr _res sub "," "_" ${console}
if test "${_res}" = "" -o "${_res}" = "${console}"; then
	env set console "${console},${baudrate}"
fi

env set appendargs @@APPEND@@
env set setupargs console=tty1 console=${console}

env set bootcmd_unzip ';'
if test -n "${kernel_comp_addr_r}"; then
    # use booti automatic decompression
    env set kernel_addr_load ${loadaddr}
elif test "${kernel_image}" = "Image.gz"; then
    env set kernel_addr_load ${loadaddr}
    env set bootcmd_unzip 'unzip ${kernel_addr_load} ${kernel_addr_r}'
else
    env set kernel_addr_load ${kernel_addr_r}
fi

env set bootcmd_kernel "${load_cmd} ${kernel_addr_load} boot/${kernel_image}"
env set bootcmd_dtb "echo Loading DeviceTree: boot/${fdtfile}; ${load_cmd} ${fdt_addr_r} boot/${fdtfile}"
env set bootcmd_boot 'echo "Bootargs: ${bootargs}" && @@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr_r}'

env set uuid_set 'part uuid ${devtype} ${devnum}:${root_part} uuid'
env set rootfsargs_set 'run uuid_set && env set rootfsargs "root=PARTUUID=${uuid} ro rootwait rauc.slot=${rauc_slot} init=/sbin/preinit"'
env set bootcmd_args 'run rootfsargs_set && env set bootargs ${rootfsargs} ${setupargs} ${appendargs} ${tdxargs}'

env set bootcmd_run 'run m4boot; run bootcmd_dtb && run bootcmd_args && run bootcmd_kernel && run bootcmd_unzip && run bootcmd_boot; echo "Booting slot ${rauc_slot} failed!" && false'

run bootcmd_run
