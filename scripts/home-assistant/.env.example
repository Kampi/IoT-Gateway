# Copy to .env next to docker-compose.yml and adjust.

# LAN interface of the Docker host that has IPv6 and faces the gateway
# (the interface carrying the host's 192.168.x.x address).
# Find it with:  ip -br addr
#   Synology with Open vSwitch: ovs_eth0, ovs_eth1, ... (here: ovs_eth2)
#   Plain Linux:                eth0, enp3s0, ...
MATTER_PRIMARY_INTERFACE=ovs_eth2
